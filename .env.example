# Copy to .env (never commit it). Generate each secret with: openssl rand -hex 32
POSTGRES_PASSWORD=
APP_REMEMBER_ME_KEY=

# First admin, created once on an empty database. Blank password = a random one, printed in the app log.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

